# NK-Base / Hermes — Environment Configuration
# Copy this file to hermes/.env and fill in the values.

# Absolute path to the project root
WORK_DIR=/path/to/NK-Base

# ─── Agent Session IDs ──────────────────────────────────────────────
# Hermes never creates sessions. All three agents are invoked as
# `<cli> --resume <UUID>`. You seed the UUIDs manually below.
# Rotate context by re-seeding these and restarting Hermes.

# Claude — how to seed:
#   1. cd into WORK_DIR and run: claude
#   2. Have one exchange, then /exit (clean exit — NOT Ctrl+C)
#   3. Copy the UUID from: "To resume this conversation, run: claude --resume <uuid>"
CLAUDE_SESSION_ID=your-claude-session-id-here

# Gemini — how to seed:
#   1. cd into WORK_DIR and run: gemini
#   2. Have one exchange, then /exit
#   3. Copy the UUID from: "To resume this session: gemini --resume <uuid>"
GEMINI_SESSION_ID=your-gemini-session-id-here

# Codex — how to seed:
#   1. Run: codex exec --full-auto --skip-git-repo-check -C "$WORK_DIR" "hello"
#   2. Copy the UUID printed at the top of stdout
#   Note: the top-level `codex resume` is TTY-only — always use `codex exec resume`.
CODEX_SESSION_ID=your-codex-session-id-here

# ─── Server Configuration ───────────────────────────────────────────

# Ports for the three Hermes servers
CHAT_PORT=3001
BUILD_PORT=3002
WARZONE_PORT=3003

# Directory for Gemini chat sessions (kept separate from WORK_DIR
# so chat Gemini doesn't write to Build-Log.md during chat)
CHAT_DIR=/tmp/argus-chat

# Auth — leave API_KEY empty for local dev (auth is disabled when unset).
# For production: set to any random secret (e.g. openssl rand -hex 32).
# Must match VITE_API_KEY in argus-ui/.env.
API_KEY=

# Bind host — which network interface the servers listen on.
# Default 127.0.0.1 = localhost only (safe). Set to 0.0.0.0 to expose on all interfaces.
BIND_HOST=127.0.0.1

# CORS — the origin the frontend is served from.
# Default works for local dev (Vite on port 5173).
# For production: set to your actual frontend URL (e.g. https://argus.yourdomain.com).
ALLOWED_ORIGIN=http://localhost:5173
