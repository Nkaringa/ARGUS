# ─── Workspaces ───────────────────────────────────────────────
# npm workspaces hoist all deps to the root node_modules.
# hermes/node_modules and argus-ui/node_modules would only exist
# if someone ran `npm install` inside a sub-package by mistake.
node_modules/
hermes/node_modules/
argus-ui/node_modules/

# ─── Environment / secrets ────────────────────────────────────
.env
.env.local
.env.*.local
hermes/.env
hermes/.env.local

# ─── Runtime artifacts ────────────────────────────────────────
# Agents write these during a build. Never committed — they regenerate per run
# and contain user-specific content. Build-History/ holds archived past tasks.
*-Plan.md
*-Build-Log.md
*-Build-Feedback.md
*-WarZone.md
Build-History/
WarZone-History/


# Runtime database (per-install). WAL mode creates -wal and -shm auxiliary files
# that are per-connection state and should never be committed either.
hermes/hermes.db
hermes/hermes.db-journal
hermes/hermes.db-wal
hermes/hermes.db-shm

# ─── Build output ─────────────────────────────────────────────
argus-ui/dist/
argus-ui/dist-ssr/
argus-ui/.vite/
.obsidian/

# ─── Landing site (separate repo) ─────────────────────────────
# The landing page is pushed to its own repository.
landing/

# ─── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*

# ─── Claude Code ──────────────────────────────────────────────
.claude/worktrees/

# ─── OS / editor ──────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ─── Internal memory (not for GitHub) ─────────────────────────
docs/
